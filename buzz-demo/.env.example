# Buzz demo relay environment (ADR 014 ephemeral demo mode).
#
# Copy to .env in this directory, fill secrets from the deployment secret
# store, and keep the populated copy out of Git. This Compose project is
# deliberately separate from the protected `speakerops` project: it never
# shares volumes, networks, or deploy scripts with it.

# Audited multi-architecture image for upstream source revision
# 07a3c768d619db31fee3f0590f9433cdd1213e8f. Never replace this with `main`, a
# mutable tag, or an unverified digest. Re-audit ADR 014 before changing it.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:ff848b46692ca254d0b275deaa24a8e32e4e510ab28787027178453b729f7ebd

# Public host name (used by URL-derived settings). Local relay binds on
# 127.0.0.1:3100 — 3000 is reserved for the wiki-demo dev server.
BUZZ_DOMAIN=localhost
RELAY_URL=ws://127.0.0.1:3100
BUZZ_MEDIA_BASE_URL=http://127.0.0.1:3100/media
BUZZ_MEDIA_SERVER_DOMAIN=localhost
BUZZ_CORS_ORIGINS=http://127.0.0.1:3100

# The Compose contract hard-enables both gates. These duplicate values make
# the intended posture visible to operators; setting either false cannot open
# the relay because compose.yml deliberately does not interpolate them.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=false
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity. The desktop app's own Nostr identity; lets the relay anchor
# the membership snapshot the desktop agent infrastructure polls. Set to the
# 64-hex pubkey of the demo owner.
RELAY_OWNER_PUBKEY=

# Stable secrets. Generate once with `openssl rand -hex N` and back them up.
BUZZ_RELAY_PRIVATE_KEY=
BUZZ_GIT_HOOK_HMAC_SECRET=
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path

BUZZ_HTTP_PORT=3100
