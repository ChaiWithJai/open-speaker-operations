[Unit]
Description=Nightly Speaker Operations database and media backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=speakerops-deploy
Group=docker
WorkingDirectory=/opt/open-speaker-operations
EnvironmentFile=-/etc/speakerops/backup.env
ExecStart=/opt/open-speaker-operations/backup-nightly.sh --app-dir /opt/open-speaker-operations --project speakerops
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
