# Buzz agent bridge provider configuration (issue #67 handoff, step 1).
#
# This file configures the speakerops-buzz agent process ONLY. It must never
# be loaded by the protected SpeakerOps Compose project, the Buzz relay, or a
# browser. Copy it next to the agent deployment, fill the blanks from the
# deployment secret store, and keep the populated copy out of Git.
#
# Provider dialect is pinned: Buzz generic OpenAI-compatible mode, chat API.
BUZZ_AGENT_PROVIDER=openai
OPENAI_COMPAT_API=chat

# Together AI profile:
#   OPENAI_COMPAT_BASE_URL=https://api.together.ai/v1
#   OPENAI_COMPAT_MODEL=<approved-tools-capable-together-model-id>
# Local profile (agent-reachable Ollama/vLLM, private network only):
#   OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_COMPAT_MODEL=<installed-local-model>
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# Secret. Inject from the environment/secret store; never commit a value.
# Optional for private local endpoints, required for public providers.
OPENAI_COMPAT_API_KEY=

# Bounded request budgets (defaults: 30s timeout, 2 retries, 1024 tokens).
BUZZ_AGENT_TIMEOUT_SECONDS=
BUZZ_AGENT_MAX_RETRIES=
BUZZ_AGENT_MAX_OUTPUT_TOKENS=

# Must remain false until the bounded-write step of issue #67 is approved.
BUZZ_AGENT_WRITES_ENABLED=false
